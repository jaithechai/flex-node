# Fine-grained token with Contents read and write for this repository only.
GITHUB_TOKEN=
# Repository that receives the public status branch.
REPO=jaithechai/flex-node
# Private healthchecks.io ping URL.
HEALTHCHECK_URL=
# Process names without .exe, separated by commas; empty disables watching.
WATCH=Honeygain,EarnApp
# The next two keys belong only on the machine that runs balances.ps1.
# Honeygain dashboard JWT session token.
HONEYGAIN_TOKEN=
# Pawns dashboard session token without the Bearer prefix.
PAWNS_TOKEN=
